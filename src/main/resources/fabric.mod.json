{
  "schemaVersion": 1,
  "id": "bigger-boats",
  "version": "${version}",
  "name": "Bigger Boats",
  "description": "Lets up to four players ride in vanilla boats, with optional client-side seat spacing and dynamic boat stretching.",
  "authors": ["Tempest Studios"],
  "contact": {
    "homepage": "https://github.com/tempeststudios/bigger-boats"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/bigger-boats/icon.jpg",
  "environment": "*",
  "entrypoints": {
    "main": ["tempeststudios.biggerboats.BiggerBoats"],
    "client": ["tempeststudios.biggerboats.BiggerBoatsClient"]
  },
  "mixins": [
    "bigger-boats.mixins.json",
    {
      "config": "bigger-boats.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
